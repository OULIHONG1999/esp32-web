[Unit]
Description=Font Cloud Server (font subsetting API + test bench)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/font-cloud-server
Environment=PORT=8788
Environment=HOST=127.0.0.1
ExecStart=/opt/font-cloud-server/.venv/bin/python /opt/font-cloud-server/server.py --host 127.0.0.1 --port 8788
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
